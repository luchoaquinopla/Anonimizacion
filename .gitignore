.atl/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Artefactos locales y worktrees auxiliares
/tmp/
/.local-backups/
/.worktrees/

# PDFs reales o de prueba manual -- nunca deben vivir dentro del repo,
# ver scripts/procesar_carpeta.py. Segunda defensa además de "usar una
# carpeta fuera del repo": si alguna vez cae acá adentro, git la ignora.
*.pdf
/pdfs*/
/lote*/
/entrada*/
/pdf-prueba*/

# Configuración local del operador (`scripts/instalar.ps1` la genera a
# partir de `deploy/anonimizacion.toml.example`): puede llevar una URL de
# Postgres con credenciales embebidas específicas de una máquina. El
# ejemplo versionado (`.example`) no queda afectado por este patrón.
/anonimizacion.toml

# Segunda defensa para secretos (pepper, secreto del panel): el instalador
# los escribe FUERA del repositorio por defecto (perfil del usuario de
# Windows), pero si alguna vez alguien los apunta a una carpeta local acá
# adentro, que git los ignore igual -- nunca deben versionarse.
/secretos/
*.pepper
